<%= form_with model: task  do |f| %>
  <%= f.label :title%>
  <%= f.text_field :title %>
  <%= f.label :details %>
  <%= f.text_area :details %>
  <% unless task.new_record? %>
    <div>
      <%= f.check_box :completed %>
      <%= f.label :completed%>
    </div>
  <% end%>
  <%= f.submit nil, :class => 'my-btn mt-3 btn btn-primary' %>
<% end %>
